/*
AutoLabeler Desktop Application Stylesheet
==========================================
Design System: UI_DESIGN_SPEC_v2.md sections 1.1-1.7
Version: 2.1 (Performance Optimized)
Last Updated: 2026-08-24

Performance Optimizations:
- Border-simulated shadows for static elements
- Selective real shadows via Python (QGraphicsDropShadowEffect)
- Transparent border placeholders to prevent visual jumping
- GPU-accelerated animations (transform, opacity only)
*/

/* ============================================================================
   GLOBAL DEFAULTS
   ============================================================================ */

* {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "PingFang SC", "SF Pro Display", "Segoe UI", sans-serif;
    /* Note: QSS does not support CSS transition property.
       Use QPropertyAnimation in Python for smooth transitions. */
}

QWidget {
    background-color: #141922;
    color: #E6EDF3;
    font-size: 14px;
    font-weight: 400;
}

/* ============================================================================
   APPLICATION SHELL
   ============================================================================ */

/* Main Workbench View */
#workbenchView {
    background-color: #0A0E14;
}

/* Side Navigation */
#sideNav {
    background-color: #0A0E14;
    border-right: 1px solid #21262D;
    min-width: 240px;
    max-width: 240px;
}

/* Navigation Mark (Logo) */
#navMark {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #0EA5E9, stop:1 #0284C7);
    border-radius: 8px;
    min-width: 40px;
    max-width: 40px;
    min-height: 40px;
    max-height: 40px;
    font-size: 18px;
    font-weight: 700;
    color: #FFFFFF;
}

/* Navigation Brand Text */
#navBrand {
    font-size: 16px;
    font-weight: 600;
    color: #E6EDF3;
    line-height: 1.3;
}

/* Navigation Section Label */
#navSection {
    font-size: 11px;
    font-weight: 600;
    color: #6B7785;
    letter-spacing: 0.5px;
    padding: 20px 20px 8px;
}

/* Navigation Buttons (Base) */
QPushButton[objectName^="nav"] {
    background: transparent;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 6px;
    color: #9DA9BB;
    font-size: 14px;
    font-weight: 500;
    text-align: left;
    padding: 10px 20px 10px 17px;
    margin: 2px 12px;
}

QPushButton[objectName^="nav"]:hover {
    background: #141922;
    color: #E6EDF3;
}

QPushButton[objectName^="nav"]:pressed {
    background: #252D38;
}

/* Navigation Button Selected State */
QPushButton[objectName^="nav"][selected="true"] {
    background: #082F49;
    border-left: 3px solid #0EA5E9;
    color: #0EA5E9;
    font-weight: 600;
}

/* ============================================================================
   LOGIN PAGE
   ============================================================================ */

#loginView {
    background-color: #141922;
}

/* Login Story Section (Left 40%) */
#loginStory {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #0A0E14, stop:1 #141922);
}

#loginBrand {
    font-size: 32px;
    font-weight: 700;
    color: #E6EDF3;
}

#loginHeadline {
    font-size: 36px;
    font-weight: 700;
    color: #E6EDF3;
    line-height: 1.3;
}

#loginSubheadline {
    font-size: 16px;
    font-weight: 400;
    color: #9DA9BB;
    line-height: 1.7;
}

#loginStatValue {
    font-size: 40px;
    font-weight: 700;
    color: #0EA5E9;
}

#loginStatLabel {
    font-size: 14px;
    color: #6B7785;
}

#loginStoryFooter {
    font-size: 13px;
    color: #6B7785;
}

/* Login Form Area (Right 60%) */
#loginFormArea {
    background-color: #141922;
}

/* Login Card - Uses real shadow (applied via Python) */
#loginCard {
    background-color: #1C2128;
    border: 1px solid #30363D;
    border-radius: 12px;
}

#loginFormTitle {
    font-size: 28px;
    font-weight: 700;
    color: #E6EDF3;
}

#loginFormSubtitle {
    font-size: 14px;
    color: #9DA9BB;
}

#loginFieldLabel {
    font-size: 14px;
    font-weight: 500;
    color: #E6EDF3;
}

#loginForgotLink {
    font-size: 13px;
    color: #0EA5E9;
}

#loginOptionLabel {
    font-size: 12px;
    color: #6B7785;
    letter-spacing: 0.5px;
}

/* ============================================================================
   HOMEPAGE
   ============================================================================ */

#homePage {
    background-color: #0A0E14;
}

/* Hero Section */
#homeHero {
    background-color: #141922;
    border: 1px solid #21262D;
    border-bottom: 2px solid #1A1F29;
    border-radius: 8px;
}

#homeEyebrow {
    font-size: 12px;
    font-weight: 600;
    color: #6B7785;
    letter-spacing: 0.5px;
}

#homeTitle {
    font-size: 28px;
    font-weight: 700;
    color: #E6EDF3;
    line-height: 1.2;
}

/* Module Panel */
#homeModulePanel {
    background: transparent;
}

/* Module Card Button */
#moduleCardButton {
    background-color: #141922;
    border: 1px solid #21262D;
    border-bottom: 2px solid #1A1F29;
    border-radius: 8px;
    padding: 10px 12px;
    min-height: 108px;
}

#moduleCardButton:hover {
    border-color: #30363D;
    border-bottom: 3px solid #21262D;
}

#moduleCardButton:pressed {
    background-color: #1C2128;
}

#moduleTitleText {
    font-size: 15px;
    font-weight: 600;
    color: #E6EDF3;
}

#moduleDescription {
    font-size: 12px;
    color: #9DA9BB;
    line-height: 1.4;
}

/* AI Preview Panel */
#aiPreview {
    background-color: #141922;
    border: 1px solid #21262D;
    border-radius: 8px;
}

#aiTitle {
    font-size: 15px;
    font-weight: 600;
    color: #E6EDF3;
}

#aiStatus {
    background-color: #78350F;
    color: #F59E0B;
    font-size: 10px;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 4px;
}

#aiChip {
    background-color: #252D38;
    color: #9DA9BB;
    font-size: 12px;
    padding: 4px 10px;
    border-radius: 4px;
}

#aiThread {
    background-color: #1C2128;
    border-radius: 6px;
}

#aiBubbleUser {
    background-color: #082F49;
    color: #E6EDF3;
    font-size: 12px;
    padding: 8px 10px;
    border-radius: 6px;
}

#aiBubbleBot {
    background-color: #252D38;
    color: #9DA9BB;
    font-size: 12px;
    padding: 8px 10px;
    border-radius: 6px;
}

#aiInput {
    background-color: #1C2128;
    border: 1px solid #30363D;
    border-radius: 6px;
}

#aiInputHint {
    font-size: 12px;
    color: #6B7785;
}

#aiSendButton {
    background-color: #30363D;
    color: #6B7785;
    font-size: 12px;
    padding: 6px 12px;
    border-radius: 4px;
    border: none;
}

/* Support Panel */
#homeSupportPanel {
    background-color: #141922;
    border: 1px solid #21262D;
    border-radius: 8px;
}

#homeSectionTitle {
    font-size: 15px;
    font-weight: 600;
    color: #E6EDF3;
}

#supportCore {
    background-color: #0EA5E9;
    color: #FFFFFF;
    font-size: 10px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
}

#homeStrengthBand {
    background: transparent;
}

#strengthItem {
    background-color: #1C2128;
    border: 1px solid #21262D;
}

#strengthBadge {
    background-color: #252D38;
    color: #6B7785;
    font-size: 11px;
    font-weight: 600;
    border-radius: 4px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
}

#strengthTitle {
    font-size: 13px;
    font-weight: 600;
    color: #E6EDF3;
}

#strengthBody {
    font-size: 12px;
    color: #9DA9BB;
    line-height: 1.4;
}

#strengthDivider {
    background-color: #21262D;
}

#developerLabel {
    font-size: 12px;
    color: #6B7785;
}

/* ============================================================================
   BUTTONS
   ============================================================================ */

/* Primary Button */
QPushButton#primaryButton,
QPushButton[buttonRole="primaryAccess"] {
    background-color: #0EA5E9;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 500;
}

QPushButton#primaryButton:hover,
QPushButton[buttonRole="primaryAccess"]:hover {
    background-color: #0284C7;
    border-bottom: 2px solid #0369A1;
}

QPushButton#primaryButton:pressed,
QPushButton[buttonRole="primaryAccess"]:pressed {
    background-color: #0369A1;
}

QPushButton#primaryButton:disabled,
QPushButton[buttonRole="primaryAccess"]:disabled {
    background-color: #30363D;
    color: #6B7785;
}

/* Secondary Button */
QPushButton#secondaryButton,
QPushButton[buttonRole="reservedAccess"] {
    background: transparent;
    color: #9DA9BB;
    border: 1px solid #30363D;
    border-radius: 6px;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 400;
}

QPushButton#secondaryButton:hover {
    background-color: #252D38;
    border-color: #525964;
    color: #E6EDF3;
}

QPushButton#secondaryButton:pressed {
    background-color: #2D3642;
}

QPushButton#secondaryButton:disabled {
    background: transparent;
    border-color: #30363D;
    color: #484F5C;
}

/* Danger Button */
QPushButton#dangerButton {
    background-color: #EF4444;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 500;
}

QPushButton#dangerButton:hover {
    background-color: #DC2626;
    border-bottom: 2px solid #B91C1C;
}

QPushButton#dangerButton:pressed {
    background-color: #B91C1C;
}

/* ============================================================================
   INPUT FIELDS
   ============================================================================ */

/* Form Input */
QLineEdit#formInput,
QLineEdit {
    background-color: #1A1F29;
    color: #E6EDF3;
    border: 1px solid #30363D;
    border-radius: 6px;
    padding: 10px 12px;
    font-size: 14px;
}

QLineEdit#formInput:focus,
QLineEdit:focus {
    border-color: #0EA5E9;
    outline: 2px solid rgba(14, 165, 233, 0.2);
}

QLineEdit#formInput:disabled,
QLineEdit:disabled {
    background-color: #0A0E14;
    color: #6B7785;
}

QLineEdit::placeholder {
    color: #6B7785;
}

/* ============================================================================
   COMBOBOX / DROPDOWN
   ============================================================================ */

QComboBox {
    background-color: #1A1F29;
    color: #E6EDF3;
    border: 1px solid #30363D;
    border-radius: 6px;
    padding: 10px 12px;
    font-size: 14px;
}

QComboBox:hover {
    border-color: #525964;
}

QComboBox:focus {
    border-color: #0EA5E9;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #9DA9BB;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #1C2128;
    border: 1px solid #30363D;
    border-radius: 6px;
    selection-background-color: #082F49;
    selection-color: #0EA5E9;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    color: #E6EDF3;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #252D38;
}

/* ============================================================================
   CARDS
   ============================================================================ */

/* Standard Card */
QFrame[objectName*="Card"],
QFrame[objectName*="Panel"] {
    background-color: #141922;
    border: 1px solid #21262D;
    border-bottom: 2px solid #1A1F29;
    border-radius: 8px;
}

/* ============================================================================
   PROGRESS BARS
   ============================================================================ */

/* Small Progress Bar (8px - Task Center) */
QProgressBar[height="small"] {
    background-color: #1A1F29;
    border: none;
    border-radius: 4px;
    text-align: center;
    height: 8px;
}

QProgressBar[height="small"]::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #0EA5E9, stop:1 #0284C7);
    border-radius: 4px;
}

/* Large Progress Bar (24px - Main Progress Display) */
QProgressBar {
    background-color: #1A1F29;
    border: none;
    border-radius: 6px;
    text-align: center;
    height: 24px;
    color: #E6EDF3;
    font-size: 14px;
    padding: 0 12px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #0EA5E9, stop:1 #0284C7);
    border-radius: 6px;
}

/* ============================================================================
   BADGES / TAGS
   ============================================================================ */

/* Default Badge */
QLabel[objectName*="Badge"],
QLabel[objectName*="Tag"] {
    background-color: #252D38;
    color: #9DA9BB;
    padding: 4px 10px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 500;
}

/* Status Badges */
QLabel[status="running"] {
    background-color: #065F46;
    color: #10B981;
}

QLabel[status="completed"] {
    background-color: #1E3A8A;
    color: #3B82F6;
}

QLabel[status="failed"] {
    background-color: #7F1D1D;
    color: #EF4444;
}

QLabel[status="cancelled"],
QLabel[status="interrupted"] {
    background-color: #92400E;
    color: #F59E0B;
}

QLabel[status="queued"] {
    background-color: #252D38;
    color: #9DA9BB;
}

/* ============================================================================
   TASK CENTER
   ============================================================================ */

#taskCenterPage {
    background-color: #0A0E14;
}

#taskCenterSummaryPanel {
    background-color: #1C2128;
    border: 1px solid #21262D;
    border-radius: 8px;
}

#taskCenterList {
    background: transparent;
}

/* ============================================================================
   TASK CENTER PAGE
   ============================================================================ */

/* Filter Panel */
#taskCenterFilterPanel {
    background-color: #1C2128;
    border: 1px solid #21262D;
    border-radius: 8px;
}

/* Filter Buttons */
QPushButton[objectName="taskFilterButton"] {
    background: transparent;
    border: 1px solid #30363D;
    border-radius: 6px;
    color: #9DA9BB;
    font-size: 13px;
    font-weight: 500;
    padding: 8px 16px;
    min-width: 80px;
}

QPushButton[objectName="taskFilterButton"]:hover {
    background: #252D38;
    border-color: #525964;
    color: #E6EDF3;
}

QPushButton[objectName="taskFilterButton"][active="true"] {
    background: #082F49;
    border-color: #0EA5E9;
    color: #0EA5E9;
    font-weight: 600;
}

/* Task Card */
#taskCard {
    background-color: #141922;
    border: 1px solid #21262D;
    border-bottom: 2px solid #1A1F29;
    border-radius: 8px;
}

/* Task Module Icon */
#taskModuleIcon {
    font-size: 24px;
    color: #E6EDF3;
}

/* Task Module Name */
#taskModuleName {
    font-size: 16px;
    font-weight: 600;
    color: #E6EDF3;
}

/* Task Status Badge */
#taskStatusBadge {
    font-size: 12px;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 4px;
}

#taskStatusBadge[status="running"] {
    background-color: #065F46;
    color: #10B981;
}

#taskStatusBadge[status="succeeded"] {
    background-color: #1E3A8A;
    color: #3B82F6;
}

#taskStatusBadge[status="failed"] {
    background-color: #7F1D1D;
    color: #EF4444;
}

#taskStatusBadge[status="cancelled"],
#taskStatusBadge[status="interrupted"] {
    background-color: #92400E;
    color: #F59E0B;
}

#taskStatusBadge[status="queued"] {
    background-color: #252D38;
    color: #9DA9BB;
}

/* Task Description */
#taskDescription {
    font-size: 14px;
    color: #9DA9BB;
    line-height: 1.5;
}

/* Task Time Info */
#taskTimeInfo {
    font-size: 13px;
    color: #6B7785;
}

/* Task Progress Text */
#taskProgressText {
    font-size: 13px;
    color: #9DA9BB;
}

/* Task Error Panel */
#taskErrorPanel {
    background-color: #7F1D1D;
    border: 1px solid #991B1B;
    border-left: 4px solid #EF4444;
    border-radius: 6px;
}

#taskErrorText {
    font-size: 13px;
    color: #EF4444;
    line-height: 1.5;
}

/* Task Output Path */
#taskOutputPath {
    font-size: 13px;
    color: #6B7785;
}

/* Delete Confirmation Dialog */
#deleteConfirmationDialog {
    background-color: #1C2128;
    border: 1px solid #30363D;
    border-radius: 12px;
}

#dialogTitle {
    font-size: 18px;
    font-weight: 600;
    color: #E6EDF3;
}

#dialogDescription {
    font-size: 14px;
    color: #9DA9BB;
    line-height: 1.5;
}

#taskDetailsPanel {
    background-color: #252D38;
    border-left: 3px solid #EF4444;
    border-radius: 4px;
}

#taskDetailsText {
    font-size: 13px;
    color: #E6EDF3;
}

/* ============================================================================
   MANUAL PAGE
   ============================================================================ */

#manualPage {
    background-color: #0A0E14;
}

#leftMainPanel {
    background-color: #141922;
    border: 1px solid #21262D;
    border-radius: 8px;
}

#rightSupportPanel {
    background-color: #141922;
    border: 1px solid #21262D;
    border-radius: 8px;
}

#eyebrow {
    font-size: 12px;
    font-weight: 600;
    color: #6B7785;
    letter-spacing: 0.5px;
}

#toolTitle {
    font-size: 28px;
    font-weight: 700;
    color: #E6EDF3;
}

#smallTitle {
    font-size: 16px;
    font-weight: 600;
    color: #E6EDF3;
}

#mutedText {
    font-size: 14px;
    color: #9DA9BB;
}

#panelTitle {
    font-size: 15px;
    font-weight: 600;
    color: #E6EDF3;
}

/* Manual Section */
#manualSection {
    background-color: #1C2128;
    border: 1px solid #21262D;
    border-radius: 8px;
}

#manualSectionTitle {
    font-size: 16px;
    font-weight: 600;
    color: #E6EDF3;
}

#manualParamTable {
    background: transparent;
}

#manualTableHeader {
    font-size: 13px;
    font-weight: 600;
    color: #E6EDF3;
    padding: 8px;
}

#manualTableCell {
    font-size: 13px;
    color: #9DA9BB;
    padding: 6px 8px;
}

#manualNote {
    background-color: #082F49;
    border-left: 3px solid #0EA5E9;
    border-radius: 4px;
}

#manualStepsPanel {
    background: transparent;
}

#manualStepButton {
    background-color: #1C2128;
    border: 1px solid #21262D;
    color: #E6EDF3;
    text-align: left;
    padding: 12px;
    border-radius: 6px;
    font-size: 13px;
}

#manualStepButton:hover {
    background-color: #252D38;
    border-color: #30363D;
}

#manualNavButton {
    background: transparent;
    border: none;
    color: #9DA9BB;
    text-align: left;
    padding: 8px 12px;
    border-radius: 4px;
    font-size: 13px;
}

#manualNavButton:hover {
    background-color: #252D38;
    color: #E6EDF3;
}

/* Scroll Area */
#manualContentScroll,
#settingsContentScroll {
    background: transparent;
    border: none;
}

QScrollArea QWidget {
    background: transparent;
}

/* ============================================================================
   SETTINGS PAGE
   ============================================================================ */

#settingsPage {
    background-color: #0A0E14;
}

#settingsDefaultsForm {
    background: transparent;
}

#settingsStatusPanel {
    background-color: #1C2128;
    border: 1px solid #21262D;
    border-radius: 8px;
}

#settingsStatusItem {
    background-color: #252D38;
    border-radius: 6px;
}

#formPlaceholder {
    font-size: 14px;
    color: #9DA9BB;
}

#formPlaceholder[feedbackRole="result"] {
    font-weight: 500;
}

/* ============================================================================
   SCROLL BARS
   ============================================================================ */

QScrollBar:vertical {
    background-color: #141922;
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #30363D;
    border-radius: 6px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #525964;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #141922;
    height: 12px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: #30363D;
    border-radius: 6px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #525964;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ============================================================================
   TEXT STYLES
   ============================================================================ */

/* Headings */
QLabel[heading="h1"] {
    font-size: 28px;
    font-weight: 600;
    color: #E6EDF3;
    line-height: 1.2;
}

QLabel[heading="h2"] {
    font-size: 22px;
    font-weight: 600;
    color: #E6EDF3;
    line-height: 1.2;
}

QLabel[heading="h3"] {
    font-size: 18px;
    font-weight: 600;
    color: #E6EDF3;
    line-height: 1.2;
}

QLabel[heading="h4"] {
    font-size: 16px;
    font-weight: 600;
    color: #E6EDF3;
    line-height: 1.2;
}

/* ============================================================================
   ERROR / WARNING / SUCCESS STATES
   ============================================================================ */

/* Error Panel */
QFrame[state="error"] {
    background-color: #7F1D1D;
    border: 1px solid #991B1B;
    border-left: 4px solid #EF4444;
    border-radius: 6px;
}

QLabel[state="error"] {
    color: #EF4444;
}

/* Warning Panel */
QFrame[state="warning"] {
    background-color: #78350F;
    border: 1px solid #92400E;
    border-left: 4px solid #F59E0B;
    border-radius: 6px;
}

QLabel[state="warning"] {
    color: #F59E0B;
}

/* Success Panel */
QFrame[state="success"] {
    background-color: #064E3B;
    border: 1px solid #065F46;
    border-left: 4px solid #10B981;
    border-radius: 6px;
}

QLabel[state="success"] {
    color: #10B981;
}

/* Info Panel */
QFrame[state="info"] {
    background-color: #1E3A8A;
    border: 1px solid #1E40AF;
    border-left: 4px solid #3B82F6;
    border-radius: 6px;
}

QLabel[state="info"] {
    color: #3B82F6;
}

/* ============================================================================
   TOOL PAGES (Common Elements)
   ============================================================================ */

/* Tool Page Container */
QWidget[objectName*="Page"] {
    background-color: #0A0E14;
}

/* Form Labels */
QLabel[role="formLabel"] {
    font-size: 14px;
    font-weight: 500;
    color: #E6EDF3;
}

/* Form Hints */
QLabel[role="formHint"] {
    font-size: 13px;
    color: #6B7785;
}

/* Section Divider */
QFrame[role="divider"] {
    background-color: #21262D;
    max-height: 1px;
}

/* ============================================================================
   EMPTY STATES
   ============================================================================ */

QFrame[state="empty"] {
    background: transparent;
}

QLabel[role="emptyIcon"] {
    font-size: 64px;
    color: #30363D;
}

QLabel[role="emptyTitle"] {
    font-size: 18px;
    font-weight: 600;
    color: #9DA9BB;
}

QLabel[role="emptyDescription"] {
    font-size: 14px;
    color: #6B7785;
    line-height: 1.5;
}

/* ============================================================================
   LOADING STATES
   ============================================================================ */

/* Spinner containers handled via Python QPropertyAnimation */

QLabel[role="loadingText"] {
    font-size: 15px;
    font-weight: 500;
    color: #9DA9BB;
}

QLabel[role="loadingHint"] {
    font-size: 13px;
    color: #6B7785;
}

/* ============================================================================
   CONTEXT MENUS & TOOLTIPS
   ============================================================================ */

QMenu {
    background-color: #1C2128;
    border: 1px solid #30363D;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    background: transparent;
    color: #E6EDF3;
    padding: 8px 16px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #252D38;
}

QMenu::item:disabled {
    color: #6B7785;
}

QToolTip {
    background-color: #1C2128;
    color: #E6EDF3;
    border: 1px solid #30363D;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 13px;
}

/* ============================================================================
   CHECKBOXES & RADIO BUTTONS
   ============================================================================ */

QCheckBox {
    color: #E6EDF3;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #30363D;
    border-radius: 4px;
    background-color: #1A1F29;
}

QCheckBox::indicator:hover {
    border-color: #525964;
}

QCheckBox::indicator:checked {
    background-color: #0EA5E9;
    border-color: #0EA5E9;
    image: none;
}

QCheckBox::indicator:disabled {
    background-color: #0A0E14;
    border-color: #30363D;
}

QRadioButton {
    color: #E6EDF3;
    spacing: 8px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #30363D;
    border-radius: 9px;
    background-color: #1A1F29;
}

QRadioButton::indicator:hover {
    border-color: #525964;
}

QRadioButton::indicator:checked {
    background-color: #0EA5E9;
    border-color: #0EA5E9;
}

QRadioButton::indicator:disabled {
    background-color: #0A0E14;
    border-color: #30363D;
}

/* ============================================================================
   SPECIFIC WIDGET FIXES
   ============================================================================ */

/* QTreeWidget (Code/Product Tree) */
QTreeWidget {
    background-color: #1A1F29;
    border: 1px solid #30363D;
    border-radius: 6px;
    color: #E6EDF3;
}

QTreeWidget::item {
    padding: 6px;
}

QTreeWidget::item:hover {
    background-color: #252D38;
}

QTreeWidget::item:selected {
    background-color: #082F49;
    color: #0EA5E9;
}

/* QTextEdit (for logs, multi-line text) */
QTextEdit {
    background-color: #1A1F29;
    border: 1px solid #30363D;
    border-radius: 6px;
    color: #E6EDF3;
    font-family: "Consolas", "Monaco", "SF Mono", monospace;
    font-size: 13px;
    padding: 8px;
}

QPlainTextEdit {
    background-color: #1A1F29;
    border: 1px solid #30363D;
    border-radius: 6px;
    color: #E6EDF3;
    font-family: "Consolas", "Monaco", "SF Mono", monospace;
    font-size: 13px;
    padding: 8px;
}

/* QSpinBox / QDoubleSpinBox */
QSpinBox, QDoubleSpinBox {
    background-color: #1A1F29;
    border: 1px solid #30363D;
    border-radius: 6px;
    padding: 8px 12px;
    color: #E6EDF3;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #0EA5E9;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    background-color: #252D38;
    border-left: 1px solid #30363D;
    border-top-right-radius: 6px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #252D38;
    border-left: 1px solid #30363D;
    border-bottom-right-radius: 6px;
}

/* ============================================================================
   END OF STYLESHEET
   ============================================================================ */
