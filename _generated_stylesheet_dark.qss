/* ============================================================================
   AutoLabeler Theme: Dark
   Generated by ThemeManager
   ============================================================================ */

/* Global Base Styles */
* {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI", sans-serif;
    /* Transitions handled by QPropertyAnimation in Python */
}

QWidget {
    background-color: #0A0E14;
    color: #E6EDF3;
    font-size: 14px;
    font-weight: 400;
}

/* ============================================================================
   Application Shell
   ============================================================================ */

#workbenchView {
    background-color: #0A0E14;
}

#loginView {
    background-color: #0A0E14;
}

/* ============================================================================
   Side Navigation
   ============================================================================ */

#sideNav {
    background-color: #0A0E14;
    border-right: 1px solid #21262D;
    min-width: 240px;
    max-width: 240px;
}

#navMark {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #0EA5E9,
                                stop:1 #0284C7);
    color: #FFFFFF;
    font-size: 18px;
    font-weight: 700;
    border-radius: 8px;
    min-width: 40px;
    max-width: 40px;
    min-height: 40px;
    max-height: 40px;
}

#navBrand {
    color: #E6EDF3;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.2;
}

#navSection {
    color: #6B7785;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
    padding: 20px 20px 8px;
}

QPushButton[objectName="navButton"] {
    background-color: transparent;
    color: #9DA9BB;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 6px;
    padding: 10px 20px 10px 17px;
    margin: 2px 12px;
    font-size: 14px;
    font-weight: 500;
    text-align: left;
}

QPushButton[objectName="navButton"]:hover {
    background-color: #141922;
    color: #E6EDF3;
}

QPushButton[objectName="navButton"][selected="true"] {
    background-color: #082F49;
    color: #0EA5E9;
    border-left: 3px solid #0EA5E9;
    font-weight: 600;
}

/* ============================================================================
   Buttons
   ============================================================================ */

#primaryButton {
    background-color: #0EA5E9;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 14px 28px;
    font-size: 15px;
    font-weight: 600;
}

#primaryButton:hover {
    background-color: #0284C7;
}

#primaryButton:pressed {
    background-color: #0369A1;
}

#primaryButton:disabled {
    background-color: #30363D;
    color: #6B7785;
}

#secondaryButton {
    background-color: transparent;
    color: #9DA9BB;
    border: 1px solid #30363D;
    border-radius: 6px;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 500;
}

#secondaryButton:hover {
    background-color: #252D38;
    border-color: #525964;
    color: #E6EDF3;
}

#secondaryButton:pressed {
    background-color: #2D3642;
}

#secondaryButton:disabled {
    background-color: transparent;
    color: #6B7785;
    border-color: #30363D;
    cursor: not-allowed;
}

/* ============================================================================
   Input Fields
   ============================================================================ */

#formInput, QLineEdit {
    background-color: #1A1F29;
    color: #E6EDF3;
    border: 1px solid #30363D;
    border-radius: 6px;
    padding: 12px 14px;
    font-size: 14px;
}

#formInput:focus, QLineEdit:focus {
    border-color: #0EA5E9;
    outline: 2px solid rgba(14, 165, 233, 0.2);
    outline-offset: 0px;
}

#formInput:disabled, QLineEdit:disabled {
    background-color: #0A0E14;
    color: #6B7785;
}

QComboBox {
    background-color: #1A1F29;
    color: #E6EDF3;
    border: 1px solid #30363D;
    border-radius: 6px;
    padding: 10px 12px;
    font-size: 14px;
}

QComboBox:hover {
    border-color: #0EA5E9;
}

QComboBox::drop-down {
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #1C2128;
    border: 1px solid #30363D;
    selection-background-color: #082F49;
    selection-color: #0EA5E9;
}

/* ============================================================================
   Cards and Panels
   ============================================================================ */

QFrame[objectName*="Card"], QFrame[objectName*="Panel"] {
    background-color: #141922;
    border: 1px solid #21262D;
    border-bottom: 2px solid #1A1F29;
    border-radius: 8px;
    padding: 24px;
}

#homeHero, #homeModulePanel, #homeSupportPanel {
    background-color: #141922;
    border: 1px solid #21262D;
    border-bottom: 2px solid #1A1F29;
    border-radius: 8px;
}

#aiPreview {
    background-color: #141922;
    border: 1px solid #21262D;
    border-radius: 8px;
}

/* ============================================================================
   Typography
   ============================================================================ */

#toolTitle {
    font-size: 28px;
    font-weight: 700;
    color: #E6EDF3;
    line-height: 1.2;
}

#loginCard {
    background-color: #1C2128;
    border: 1px solid #30363D;
    border-radius: 12px;
}

#loginCardContainer {
    background: #141922;
}

/* ============================================================================
   End of Stylesheet
   ============================================================================ */